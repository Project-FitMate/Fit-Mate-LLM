# Shared secret with Next.js backend (sent as X-API-Key header)
API_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Naver Search (https://developers.naver.com)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_SEARCH_DISPLAY=20

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Fitting
FITTING_TIMEOUT_SECONDS=60
